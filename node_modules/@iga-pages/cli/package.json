{
  "name": "@iga-pages/cli",
  "version": "1.0.3",
  "description": "A CLI tool for IGA Pages",
  "main": "dist/index.js",
  "bin": {
    "iga": "./bin/iga.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "build:tsc": "tsc",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cli",
    "deployment",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "^0.19.11"
  },
  "devDependencies": {
    "@rslib/core": "^0.19.3",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/http-proxy": "^1.17.17",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.6",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "@types/serve-handler": "^6.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@volcengine/openapi": "^1.36.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.4",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "get-port": "^5.1.1",
    "glob": "^10.3.10",
    "http-proxy": "^1.18.1",
    "mime-types": "^2.1.35",
    "ora": "^5.4.1",
    "p-limit": "^3.1.0",
    "prompts": "^2.4.2",
    "semver": "^7.7.3",
    "serve-handler": "^6.1.6",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
